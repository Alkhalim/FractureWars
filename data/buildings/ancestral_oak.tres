[resource]
script = ExtResource("1")
id = &"ancestral_oak"
display_name = "Ancestral Oak III"
description = "The eldest tree in the grove — older than memory, wider than a hall. Its roots connect to every living thing in the forest. When the Oak speaks, the Gladehost listens."
faction_id = &"gladehost"
category = &"cultural"
build_cost = {0: 580, 5: 100}
build_time = 4
income_bonus = {2: 40}
population_growth_bonus = 8
unlocks_units = Array[StringName]([&"root_sentinel"])
required_capital_level = 3
upgrades_from = &"druid_circle"
class_loyalty_bonus = {"peasants": 3, "artisans": 1, "scholars": 5, "nobles": 2}
