[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/building_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"grand_forge"
display_name = "Grand Forge III"
description = "The pinnacle of Cinderguard engineering — a cathedral-sized forge fed by volcanic vents. Here, iron colossi are assembled and forge wardens receive their eternal mantles."
faction_id = &"cinderguard"
category = &"military"
build_cost = {0: 560, 1: 120, 5: 85}
build_time = 4
population_growth_bonus = 2
defense_bonus = 3
unlocks_units = Array[StringName]([&"iron_colossus", &"forge_warden"])
required_capital_level = 3
upgrades_from = &"forge_chapter"
class_loyalty_bonus = {"peasants": -3, "nobles": 5}
