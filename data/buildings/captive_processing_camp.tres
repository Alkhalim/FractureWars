[gd_resource type="Resource" script_class="BuildingData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/building_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"captive_processing_camp"
display_name = "Captive Processing Camp II"
description = "A vast work camp where captives labor to process jungle hardwood and forge jade-steel. More efficient than thrall quarters but requires more captive throughput. Some captives are broken and integrated into the population (15% conversion rate)."
faction_id = &"tainted_jade"
category = &"economic"
build_cost = {0: 270, 1: 25}
build_time = 3
income_bonus = {5: 21, 1: 16}
population_growth_bonus = 6
required_capital_level = 2
upgrades_from = &"thrall_quarters"
class_loyalty_bonus = {"captives": -8, "artisans": 2}
special_effects = {"captive_conversion_rate": 0.15}
