[resource]
script = ExtResource("1")
id = &"tempest_roost"
display_name = "Tempest Roost III"
description = "A towering roost built atop the highest peaks where thunderwyrms nest amidst perpetual storm clouds. The constant exposure to storm energy grants flying units recruited here +2 attack."
