[ext_resource type="Script" path="res://scripts/resources/building_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"silverguard_citadel"
display_name = "Silverguard Citadel III"
description = "The hallowed fortress of the Silverguard elite. Moonsilver-clad towers rise above the clouds, and within, the Eclipse Champions take their eternal vows."
