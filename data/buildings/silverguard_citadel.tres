build_time = 4
population_growth_bonus = 2
defense_bonus = 3
unlocks_units = Array[StringName]([&"eclipse_champion", &"moonstone_golem"])
required_capital_level = 3
upgrades_from = &"silverguard_chapter"
class_loyalty_bonus = {"nobles": 5}
