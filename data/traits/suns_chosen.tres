[gd_resource type="Resource" script_class="CommanderTrait" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/commander_trait.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"suns_chosen"
display_name = "Sun's Chosen"
description = "Blessed by solar radiance. High Solar Faith fills this commander's troops with light — healing wounds and bolstering morale."
is_positive = true
effects = {"heal_per_turn": 0, "unit_morale_bonus": 4, "morale_recovery_mult": 0.15}
excludes = Array[StringName]([&"cruel"])
acquire_context = Array[StringName]([&"faction_sunblessed", &"battle_won"])
acquire_threshold = 4
lose_context = Array[StringName]([&"battle_lost"])
lose_threshold = 10
