[gd_resource type="Resource" script_class="CommanderTrait" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/commander_trait.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"athletic"
display_name = "Athletic"
description = "In peak physical condition, setting a brisk pace on the march."
is_positive = true
effects = {"army_speed_bonus": 1, "army_movement_bonus": 0.5}
